# Plantilla de variables de entorno del backend Python.
# Copiar a api/.env y rellenar. NUNCA comitear api/.env.
#
# En producción estas variables NO se leen de este archivo: se cargan en el panel de
# Vercel (Settings -> Environment Variables). Aquí solo sirven para el desarrollo local.

# Puerto de uvicorn en local. Vercel lo ignora: allí la app es una función serverless.
PORT=3001

# --- Fase 2: chat con IA ---
# Clave de DeepSeek, el modelo que responde en el chat del sitio.
# DEEPSEEK_API_KEY=

# Sal para derivar el identificador de visitante a partir de su IP (sha256(ip + salt)).
# Cualquier cadena larga y aleatoria sirve; si cambia, se pierde la continuidad de las
# conversaciones anteriores.
# VISITOR_ID_SALT=

# --- Fase 4: aviso por Telegram ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Fase 5: Google y correo ---
# Credenciales de la cuenta de servicio, en una sola línea (el JSON que descarga Google).
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEET_ID=
# GOOGLE_CALENDAR_ID=
# RESEND_API_KEY=
