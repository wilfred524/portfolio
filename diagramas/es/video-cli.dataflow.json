  "cards": [
    {
      "dot": "emerald",
      "title": "Paso a paso",
      "items": [
        "Cada etapa escribe su artefacto antes de que arranque la siguiente",
        "Una corrida fallida sigue desde el último paso bueno, no desde cero",
        "Lo que devuelve el modelo se valida contra un esquema, no se cree como prosa"
      ]
    },
    {
      "dot": "orange",
      "title": "Dónde ocurre el trabajo",
      "items": [
        "Transcripción y narración corren en local, sin coste por minuto de API",
        "ffmpeg hace el corte y baja la música bajo la voz",
        "Nada se publica sin aprobarlo en el panel"
      ]
    }
  ]
}
